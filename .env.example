# Copy to .env and fill in. Every value below is the default from app/config.py; only GROQ_API_KEY must be set.

# storage
DB_URL=postgresql://sonicsearch:password@localhost:5432/sonicsearch
DB_POOL_MIN=1
DB_POOL_MAX=8

# data layout
DATA_DIR=data

# ASR (Groq)
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1/audio/transcriptions
ASR_MODEL=whisper-large-v3-turbo
ASR_LANGUAGE=en
ASR_TIMEOUT_SEC=300

# retrieval (tuned on the dev split; re-index after changing EMBED_MODEL, CHUNK_*, or COLBERT_MODEL)
EMBED_MODEL=BAAI/bge-base-en-v1.5
CHUNK_WORDS=50
CHUNK_STRIDE=25
DEPTH=50
RRF_K=10
NMS_GAP_SEC=10.0
RERANK_MODEL=Alibaba-NLP/gte-reranker-modernbert-base
RERANK_MIN=0.83
COLBERT_MODEL=lightonai/GTE-ModernColBERT-v1

# docker compose only (DB_URL and DATA_DIR are set by docker-compose.yml)
POSTGRES_PASSWORD=sonicsearch
PORT=8000
